# App
NEXT_PUBLIC_APP_URL=https://your-domain.com

# MySQL (cPanel → MySQL Databases → create user + database, then assign full privileges)
DB_HOST=localhost
DB_USER=cpaneluser_toolsu
DB_PASS=your-db-password
DB_NAME=cpaneluser_toolsdb

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-min-32-chars

# CV storage path on the server (must be outside public_html)
CV_STORAGE_PATH=/home/cpaneluser/tool_cvs

# llama.cpp self-hosted AI (leave blank to use embedded offllama engine)
LLAMA_API_URL=http://your-vps-ip:8080
LLAMA_API_KEY=your-secret-key

# Paths and ports are configured automatically by the deploy workflow via GitHub Secrets.
# Never commit a real .env file — it is gitignored.
